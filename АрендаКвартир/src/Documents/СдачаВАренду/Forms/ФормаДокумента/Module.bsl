#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСтоимость()
	
	// Проверяем, что даты и квартира заполнены
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) 
		Или Не ЗначениеЗаполнено(Объект.ДатаОкончания) 
		Или Не ЗначениеЗаполнено(Объект.Квартира) Тогда
		Объект.Стоимость = 0;
		Объект.СтоимостьСНДС = 0;
		Возврат;
	КонецЕсли;
	
	// Считаем количество дней (разница в секундах / 86400 + 1)
	КоличествоДней = (Объект.ДатаОкончания - Объект.ДатаНачала) / 86400 + 1;
	
	// Если количество дней положительное, считаем стоимость
	Если КоличествоДней > 0 Тогда
		Цена = ПолучитьСтоимостьАрендыНаСервере(Объект.Квартира, Объект.Дата);
		
		// Базовая стоимость
		Объект.Стоимость = Цена * КоличествоДней;
		
		// Применяем скидку
		Скидка = Объект.Скидка / 100;
		Объект.Стоимость = Объект.Стоимость * (1 - Скидка);
		
		// Считаем сумму с НДС
		РассчитатьСтоимостьСНДС();
	Иначе
		Объект.Стоимость = 0;
		Объект.СтоимостьСНДС = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтоимостьСНДС()
	
	СтавкаНДС = Объект.СтавкаНДС;
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость * 1.05;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость * 1.07;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость * 1.1;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость * 1.22;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтоимостьАрендыНаСервере(Квартира, Дата)
	Возврат РаботаСЦенами.ПолучитьСтоимостьАренды(Квартира, Дата);
КонецФункции
#КонецОбласти

