#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Здесь можно оставить пусто
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	РассчитатьСтоимость();
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	РассчитатьСтоимость();
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	РассчитатьСтоимость();
КонецПроцедуры

&НаКлиенте
Процедура СкидкаПриИзменении(Элемент)
	РассчитатьСтоимость();
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	РассчитатьСтоимостьСНДС();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСтоимость()
	
	// Проверяем, что все данные заполнены
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Или Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Объект.Стоимость = 0;
		Объект.СтоимостьСНДС = 0;
		Возврат;
	КонецЕсли;
	
	// Считаем количество дней (разница в секундах / 86400 + 1)
	КоличествоДней = (Объект.ДатаОкончания - Объект.ДатаНачала) / 86400 + 1;
	
	// Если количество дней положительное, считаем стоимость
	Если КоличествоДней > 0 Тогда
		Цена = ПолучитьЦенуДоговораНаСервере(Объект.Договор);
		
		// Базовая стоимость
		Объект.Стоимость = Цена * КоличествоДней;
		
		// Применяем скидку
		Скидка = Объект.Скидка / 100;
		Объект.Стоимость = Объект.Стоимость * (1 - Скидка);
		
		// Считаем сумму с НДС
		РассчитатьСтоимостьСНДС();
	Иначе
		Объект.Стоимость = 0;
		Объект.СтоимостьСНДС = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтоимостьСНДС()
	
	СтавкаНДС = Объект.СтавкаНДС;
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость * 1.05;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость * 1.07;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость * 1.1;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22") Тогда
		Объект.СтоимостьСНДС = Объект.Стоимость * 1.22;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ПолучитьЦенуДоговораНаСервере(Договор)
	
	Если ЗначениеЗаполнено(Договор) Тогда
		Возврат Договор.ЦенаЗаСутки;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЭтотОбъект.ОбменДанными.Загрузка Тогда 
		Возврат; 
	КонецЕсли;
	
	// Берем суммы прямо из шапки документа (Стоимость и СтоимостьСНДС)
	ЭтотОбъект.СуммаДокумента = ЭтотОбъект.Стоимость;
	ЭтотОбъект.СуммаДокументаСНДС = ЭтотОбъект.СтоимостьСНДС;
	
КонецПроцедуры