#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	Если Договор.ВидДоговора = Перечисления.ВидыДоговоров.СПокупателем Тогда
		ИмяРегистра = "ВзаиморасчётыСПокупателями";
		ВидДвижения = ВидДвиженияНакопления.Расход;
	ИначеЕсли Договор.ВидДоговора = Перечисления.ВидыДоговоров.ССобственником Тогда
		ИмяРегистра = "ВзаиморасчётыССобственниками";
		ВидДвижения = ВидДвиженияНакопления.Приход;
	КонецЕсли;

	// Контроль отрицательных остатков по новой методике — только для Расход-направлений
	Если ВидДвижения = ВидДвиженияНакопления.Расход Тогда
		Движения[ИмяРегистра].БлокироватьДляИзменения = Истина;

		Движение = Движения[ИмяРегистра].Добавить();
		Движение.ВидДвижения = ВидДвижения;
		Движение.Период = Дата;
		Движение.Клиент = Клиент;
		Движение.Договор = Договор;
		Движение.Сумма = Сумма;

		Движения[ИмяРегистра].Записать();

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РегОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления." + ИмяРегистра + ".Остатки(
		|		&Граница,
		|		Клиент = &Клиент
		|			И Договор = &Договор) КАК РегОстатки
		|ГДЕ
		|	РегОстатки.СуммаОстаток < 0";

		Запрос.УстановитьПараметр("Граница",
			Новый Граница(МоментВремени(), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Клиент", Клиент);
		Запрос.УстановитьПараметр("Договор", Договор);

		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Отказ = Истина;

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"Сумма поступления (%1) превышает остаток задолженности арендатора — проведение невозможно",
				Сумма);
			Сообщение.Поле = "Сумма";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
		КонецЕсли;
	Иначе
		Движения[ИмяРегистра].Записывать = Истина;
		Движение = Движения[ИмяРегистра].Добавить();
		Движение.ВидДвижения = ВидДвижения;
		Движение.Период = Дата;
		Движение.Клиент = Клиент;
		Движение.Договор = Договор;
		Движение.Сумма = Сумма;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
