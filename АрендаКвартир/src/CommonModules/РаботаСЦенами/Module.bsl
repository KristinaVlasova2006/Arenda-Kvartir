#Область ПрограммныйИнтерфейс

Функция ПолучитьСтоимостьАренды(Квартира, Дата) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтоимостьАрендыСрезПоследних.ЦенаЗаСутки КАК ЦенаЗаСутки
		|ИЗ
		|	РегистрСведений.СтоимостьАренды.СрезПоследних(&Дата, Квартира = &Квартира) КАК СтоимостьАрендыСрезПоследних";
		
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Квартира", Квартира);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ЦенаЗаСутки;
	КонецЦикла;
	
	Возврат 0;
КонецФункции

#КонецОбласти