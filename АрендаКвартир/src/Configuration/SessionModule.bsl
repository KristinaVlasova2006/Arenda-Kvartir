Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)
	
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	ИдентификаторПользователяИБ = ТекущийПользователь.УникальныйИдентификатор;
	
	Сотрудник = Справочники.Сотрудники.НайтиПоРеквизиту("ИдентификаторПользователяИБ", ИдентификаторПользователяИБ);
	ПараметрыСеанса.ТекущийПользователь = Сотрудник;

КонецПроцедуры

